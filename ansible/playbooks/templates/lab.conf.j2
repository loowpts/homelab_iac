# Rate limiting
limit_req_zone $binary_remote_addr zone=mylimit:10m rate=20r/s;

# Балансировка
upstream web_servers {
    least_conn;
    server 192.168.0.22 max_fails=3 fail_timeout=30s;  # wb01
    server 192.168.0.23 max_fails=3 fail_timeout=30s;  # wb02
}

# Редирект HTTP → HTTPS
server {
    listen 80;
    server_name lb01.lab.local;
    return 301 https://$host$request_uri;
}

# HTTPS
server {
    listen 443 ssl;
    server_name lb01.lab.local;

    ssl_certificate     /etc/nginx/ssl/lb01.crt;
    ssl_certificate_key /etc/nginx/ssl/lb01.key;

    access_log /var/log/nginx/lab.access.log;
    error_log  /var/log/nginx/lab.error.log;

    location / {
        limit_req zone=mylimit burst=10 nodelay;
        proxy_pass http://web_servers;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
}
